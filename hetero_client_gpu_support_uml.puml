package "Core Implementation Layer" {
    class ObjectClientImpl <<EXISTING>> {
        - devOcImpl_: ClientDeviceObjectManager
        - workerApi_: vector<shared_ptr<IClientWorkerApi>>
        - asyncGetRPCPool_: ThreadPool
        - asyncGetCopyPool_: ThreadPool
        - asyncSetRPCPool_: ThreadPool
        --
        + MGetH2D(keys, devBlobList, timeoutMs, recorderKey): shared_future<AsyncResult>
        + MSet(keys, devBlobList, setParam, recorderKey): shared_future<AsyncResult>
        + Get(objectKeys, timeoutMs, bufferList, queryL2Cache, isRH2DSupported): Status
        + MultiCreate(objectKeys, dataSizeList, param, skipCheckExistence, bufferList, exists): Status
        + MultiPublish(bufferList, setParam, blobSizes): Status
        - **DeviceDataCreate**(objectKeys, devBlobList, setParam, bufferList, exists): Status
        - **HostDataCopy2Device**(devBlobList, existBufferList): Status
        - GetBuffersFromWorker(workerApi, getParam, objectBuffers): Status
        - MGetAsyncRpcThread(asyncResource): void
        ..
        负责MGetH2D和MSetD2H的具体实现，不需要修改
    }

    class ClientDeviceObjectManager <<MODIFIED>> {
        - swapInPool_: shared_ptr<IAsyncMemCopyPool>
        - swapOutPool_: shared_ptr<IAsyncMemCopyPool>
        - devInterImpl_: shared_ptr<DeviceManagerBase>
        --
        + MemCopyBetweenDevAndHost(devBlobList, bufferList, memcpyKind): Status
        + GetDeviceManager(): shared_ptr<DeviceManagerBase>
        ..
        **MODIFIED**: 将AsyncAclMemCopyPool改为IAsyncMemCopyPool类型
        以支持NPU和GPU两种内存拷贝池
