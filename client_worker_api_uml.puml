interface IClientWorkerCommonApi {
  ' 🎯 职责：定义所有客户端类型都需要的通用操作接口
  ' 📍 位置：src/datasystem/client/client_worker_common_api.h:142
  ' 🔧 性质：纯虚接口类

  .. 生命周期管理 ..
  + {abstract} Init(requestTimeoutMs, connectTimeoutMs): Status
  + {abstract} Disconnect(isDestruct): Status
  + {abstract} Reconnect(): Status

  .. 心跳和健康检查 ..
  + {abstract} SendHeartbeat(workerReboot, clientRemoved, ...): Status

  .. 共享内存管理 ..
  + {abstract} GetClientFd(workerFds, clientFds, tenantId): Status

  .. 高可用支持 ..
  + {abstract} GetStandbyWorkers(): vector<HostPort>

  .. 认证管理 ..
  + {abstract} UpdateToken(token): Status
  + {abstract} UpdateAkSk(accessKey, secretKey): Status

  --
  <color:blue>💡 说明：</color>
  • 定义了客户端与Worker通信的基础契约
  • 所有客户端实现都必须支持这些操作
  • 支持Token和AK/SK两种认证方式
}

note right of IClientWorkerCommonApi
  <b>核心功能：</b>
  1. <b>连接管理</b>：初始化、断开、重连
  2. <b>心跳机制</b>：检测Worker状态
  3. <b>共享内存</b>：零拷贝数据传输
  4. <b>高可用</b>：支持standby worker切换
  5. <b>安全认证</b>：Token/AK-SK更新
end note

